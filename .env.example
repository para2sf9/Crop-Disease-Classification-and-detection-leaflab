# Copy to .env and fill in your own key. NEVER commit .env.
# Get a Plant.id key here: https://plant.id/
# Keep this key server-side; do not add it to Vite/client variables.
PLANT_ID_API_KEY=

# Proxy port (the Vite dev server forwards /api here)
PORT=8787

# Optional: comma-separated origins allowed to call the proxy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: cap request body size (Vite's default JSON limit is fine for 3 images)
MAX_IMAGES=3
