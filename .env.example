# Copy to .env and fill in your own key. NEVER commit .env.
# Get a crop.health key here: https://admin.kindwise.com/signup
KINDWISE_API_KEY=

# Used automatically if Crop.health is unavailable or rejects its credentials.
# Keep both provider keys server-side; do not add them to Vite/client variables.
PLANT_ID_API_KEY=

# Proxy port (the Vite dev server forwards /api here)
PORT=8787

# Optional: comma-separated origins allowed to call the proxy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: cap request body size (Vite's default JSON limit is fine for 3 images)
MAX_IMAGES=3
